# Cyborg Job Pipeline - Environment Variables
# Copy this file to .env and fill in your values

# Folder holding profile.json and your resume PDFs (default: ./profile)
# PROFILE_DIR=./profile

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram Chat ID (get from @userinfobot on Telegram) - required; the bot ignores every other chat
TELEGRAM_CHAT_ID=your_chat_id_here

# RocketReach API Key (get from https://rocketreach.co/api)
ROCKETREACH_API_KEY=your_rocketreach_api_key_here

# Gmail SMTP for 1-Tap Cold Outreach (App Password from https://myaccount.google.com/apppasswords)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional: Custom/Generic SMTP Provider (Outlook, Fastmail, SES, Mailgun, custom domain, etc.)
# If SMTP_HOST is set, these settings take precedence over Gmail defaults.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=your_verified_sender@customdomain.com

# LinkedIn Session Cookie (Optional if using interactive login via `npm run login:linkedin`)
# Copy the 'li_at' cookie from your browser on linkedin.com
LINKEDIN_LI_AT=your_li_at_cookie_here

# Verimail.io API Key (100 free checks/month from https://verimail.io)
# Validates active mailbox deliverability and blocks hard bounces before drafting/sending
VERIMAIL_API_KEY=your_verimail_api_key_here

# NeverBounce API Key (Optional real-time mailbox verification from https://neverbounce.com)
NEVERBOUNCE_API_KEY=your_neverbounce_api_key_here

# Render Cloud Daemon Deployment (Optional: When running daemon 24/7 on Render)
# Set RENDER_DAEMON_URL on your local machine so local scraper syncs new drafts to Render
# RENDER_DAEMON_URL=https://cyborg-job-pipeline-daemon.onrender.com
# Required for the /api/draft(s) endpoints and the Apps Script relay; without it those endpoints reject every request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SYNC_SECRET=your_random_sync_secret
# PORT=10000
